PORT=3002
MAX_POINTS_PER_KEY=100000

# Persistence / autosave.
# The service stores hot data in RAM and periodically writes a full snapshot to this file.
SNAPSHOT_PATH=./data/store.snapshot.json
AUTOSAVE_INTERVAL_MS=10000
RESTORE_POINTS_PER_KEY=10000
SNAPSHOT_CHUNK_BYTES=10485760

# Source service for `npm run snapshot:pull`.
SOURCE_URL=http://45.135.182.251:3002

# API key authentication.
# If left empty or omitted — auth is disabled (development mode).
# In production set a strong random key, e.g.:
#   openssl rand -hex 32
# API_KEY=your-secret-key-here

