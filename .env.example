PORT=3002
MAX_POINTS_PER_KEY=100000

# Postgres
DB_HOST=arbi-postgres
DB_PORT=5433
DB_PORT_INTERNAL=5432
DB_USER=change_me_user
DB_PASSWORD=change_me_strong_password
DB_NAME=arbidex_market_data
DB_POOL_MAX=10

# Sync interval (ms)
SYNC_INTERVAL_MS=60000

# Restore up to N last points per key from Postgres on startup.
# The app applies a hard cap of 5000 even if this value is larger.
RESTORE_MAX_POINTS_PER_KEY=5000


# API key authentication.
# If left empty or omitted — auth is disabled (development mode).
# In production set a strong random key, e.g.:
#   openssl rand -hex 32
# API_KEY=your-secret-key-here
